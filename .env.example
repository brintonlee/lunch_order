# ---- 基本 ----
PORT=3000
# 對外網址（Discord OAuth2 callback 會用到），例如 https://lunch.example.com
PUBLIC_URL=http://localhost:3000
# SQLite 與上傳圖片存放目錄（Docker 時掛成 volume）
DATA_DIR=./data
NODE_ENV=development

# ---- Discord ----
# https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot token（留空則不啟動 Bot，只跑網站）
DISCORD_BOT_TOKEN=
# 指定伺服器 ID 可讓斜線指令立即生效（留空則註冊為全域指令，約 1 小時生效）
DISCORD_GUILD_ID=
# 初始 admin 的 Discord 使用者 ID，逗號分隔
ADMIN_DISCORD_IDS=

# ---- AI 菜單解析 ----
# gemini | openai | none
AI_PROVIDER=gemini
AI_API_KEY=
# 留空用預設：gemini → gemini-2.5-flash；openai → gpt-4o-mini
AI_MODEL=

# ---- 開發用 ----
# 設為 1 時開放 POST /api/auth/dev 直接以任意 Discord ID 登入（請勿在正式環境開啟）
DEV_LOGIN=0
